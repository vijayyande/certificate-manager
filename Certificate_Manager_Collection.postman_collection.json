{
  "info": {
    "name": "Certificate Manager - Full API",
    "_postman_id": "cert-manager-full-api",
    "description": "Complete API collection for the Certificate Manager platform and its DMZ Responder module.\n\n**Setup:**\n1. Start CM: `java -jar certificate-manager/target/certificate-manager-0.0.1-SNAPSHOT.jar --server.port=8089`\n2. Start DMZ: `java -jar dmz-responder/target/cm-dmz-responder-0.0.1-SNAPSHOT.jar --server.port=8080 --cm.base-url=http://localhost:8089 --cm.username=responder --cm.password=r3sp0nd3r!pw`\n3. Import this collection. Collection variables set `baseUrl=http://localhost:8443` and `dmzUrl=http://localhost:8080` — change if you used different ports.\n\nDemo accounts seeded on first start:\n- **admin** / **admin123** (ADMIN)\n- **requester** / **requester123** (REQUESTER)\n\nThe collection is organised into folders that mirror the backend modules. Most requests include a **Tests** tab that validates the response status code; just look at the Test Results after sending.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{adminUser}}", "type": "string" },
      { "key": "password", "value": "{{adminPass}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8443" },
    { "key": "dmzUrl", "value": "http://localhost:8080" },
    { "key": "adminUser", "value": "admin" },
    { "key": "adminPass", "value": "admin123" },
    { "key": "requesterUser", "value": "requester" },
    { "key": "requesterPass", "value": "requester123" },
    { "key": "responderUser", "value": "responder" },
    { "key": "responderPass", "value": "r3sp0nd3r!pw" }
  ],
  "item": [
    {
      "name": "System",
      "description": "General information and current user context.",
      "item": [
        {
          "name": "Get Current User (/api/me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api", "me"] },
            "description": "Returns the username and roles of the authenticated user."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('username present', () => { const d = pm.response.json(); pm.expect(d).to.have.property('username'); pm.expect(d).to.have.property('roles'); });"] } }
          ]
        },
        {
          "name": "Get System Info (/api/info)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/info", "host": ["{{baseUrl}}"], "path": ["api", "info"] },
            "description": "Returns CA/certificate counts and CRL/OCSP URL configuration."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('has counts', () => pm.response.json().counts);"] } }
          ]
        }
      ]
    },
    {
      "name": "Certificate Authorities",
      "description": "Create, inspect, revoke/suspend/resume CAs, and download CA certificates.",
      "item": [
        {
          "name": "List Active CAs (GET /api/ca/active)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/ca/active", "host": ["{{baseUrl}}"], "path": ["api", "ca", "active"] },
            "description": "Any authenticated user can list active CAs. This powers the CSR issuer and CRL dropdowns."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('is array', () => Array.isArray(pm.response.json()));"] } }
          ]
        },
        {
          "name": "List All CAs (GET /api/ca)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/ca", "host": ["{{baseUrl}}"], "path": ["api", "ca"] },
            "description": "ADMIN only. Returns all CAs including revoked/suspended."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);"] } }
          ]
        },
        {
          "name": "Get CA by ID (GET /api/ca/1)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/ca/1", "host": ["{{baseUrl}}"], "path": ["api", "ca", "1"] },
            "description": "ADMIN only. Returns full CA details including serial number, status, and certificate PEM."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('has name', () => pm.response.json().name);"] } }
          ]
        },
        {
          "name": "Create Root CA (POST /api/ca)",
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('CA created', () => { const d = pm.response.json(); pm.expect(d.success).to.be.true; pm.expect(d.data).to.have.property('id'); });"] } }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/ca", "host": ["{{baseUrl}}"], "path": ["api", "ca"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Root CA\",\n  \"subjectDn\": \"CN=Test Root CA, O=Test Org\",\n  \"caType\": \"ROOT\",\n  \"keyAlgorithm\": \"RSA\",\n  \"keySize\": 2048,\n  \"requestedBy\": \"admin\"\n}"
            },
            "description": "ADMIN only. Creates a new root CA. Returns the full CA entity."
          }
        },
        {
          "name": "Create Intermediate CA (POST /api/ca)",
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);"] } }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/ca", "host": ["{{baseUrl}}"], "path": ["api", "ca"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Intermediate CA\",\n  \"subjectDn\": \"CN=Test Intermediate CA, O=Test Org\",\n  \"caType\": \"INTERMEDIATE\",\n  \"parentCaId\": 1,\n  \"keyAlgorithm\": \"RSA\",\n  \"keySize\": 2048,\n  \"requestedBy\": \"admin\"\n}"
            },
            "description": "ADMIN only. Creates an intermediate CA under parentCaId=1."
          }
        },
        {
          "name": "Revoke CA (POST /api/ca/3/revoke)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/ca/3/revoke", "host": ["{{baseUrl}}"], "path": ["api", "ca", "3", "revoke"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"CA compromised\",\n  \"by\": \"admin\"\n}" },
            "description": "ADMIN only. Revokes a CA. Adjust the CA id in the path."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK or 400 (already revoked)', () => pm.response.code === 200 || pm.response.code === 400);"] } }
          ]
        },
        {
          "name": "Suspend CA (POST /api/ca/{id}/suspend)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/ca/1/suspend", "host": ["{{baseUrl}}"], "path": ["api", "ca", "1", "suspend"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"by\": \"admin\"\n}" },
            "description": "ADMIN only. Suspends a CA."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);"] } }
          ]
        },
        {
          "name": "Resume CA (POST /api/ca/{id}/resume)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/ca/1/resume", "host": ["{{baseUrl}}"], "path": ["api", "ca", "1", "resume"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"by\": \"admin\"\n}" },
            "description": "ADMIN only. Resumes a suspended CA."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);"] } }
          ]
        },
        {
          "name": "Download CA Certificate PEM (GET /api/ca/1/certificate.pem)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/ca/1/certificate.pem", "host": ["{{baseUrl}}"], "path": ["api", "ca", "1", "certificate.pem"] },
            "description": "ADMIN only. Downloads the CA certificate in PEM format (text/plain)."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('PEM format', () => pm.response.text().includes('-----BEGIN CERTIFICATE-----'));"] } }
          ]
        }
      ]
    },
    {
      "name": "Certificates",
      "description": "Issue certificates (CSR or manual), list, inspect, download PEM/key, and revoke/suspend/resume.",
      "item": [
        {
          "name": "Issue via CSR (POST /api/certificates/csr)",
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('cert issued', () => { const d = pm.response.json(); pm.expect(d.success).to.be.true; pm.expect(d.data).to.have.property('serialNumber'); });"] } }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/certificates/csr", "host": ["{{baseUrl}}"], "path": ["api", "certificates", "csr"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"csrPem\": \"-----BEGIN CERTIFICATE REQUEST-----\\\\n-----END CERTIFICATE REQUEST-----\",\n  \"requestedBy\": \"requester\"\n}"
            },
            "description": "REQUESTER or ADMIN. Submit a PKCS#10 CSR in PEM format. The backend selects the issuing CA automatically if issuerCaId is omitted."
          }
        },
        {
          "name": "Issue Manual Certificate (POST /api/certificates/request)",
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('cert issued', () => { const d = pm.response.json(); pm.expect(d.success).to.be.true; });"] } }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/certificates/request", "host": ["{{baseUrl}}"], "path": ["api", "certificates", "request"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commonName\": \"test-leaf.local\",\n  \"organization\": \"Test Org\",\n  \"keyAlgorithm\": \"RSA\",\n  \"keySize\": 2048,\n  \"validityDays\": 365,\n  \"dnsNames\": [\"test-leaf.local\", \"*.test-leaf.local\"],\n  \"requestedBy\": \"requester\"\n}"
            },
            "description": "REQUESTER or ADMIN. The backend generates the key pair and issues the certificate. Admins can set requestedBy; it defaults to the authenticated user."
          }
        },
        {
          "name": "List Certificates (GET /api/certificates)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/certificates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "certificates"],
              "query": [
                { "key": "q", "value": "", "description": "Free-text search on common name (optional)" },
                { "key": "status", "value": "", "description": "Filter by status: ISSUED, REVOKED, SUSPENDED, PENDING (optional)" },
                { "key": "caId", "value": "", "description": "Filter by issuing CA id (optional)" }
              ]
            },
            "description": "Returns all certificates visible to the authenticated user. Admins see all; requesters see their own."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('is array', () => Array.isArray(pm.response.json()));"] } }
          ]
        },
        {
          "name": "Get Certificate by ID (GET /api/certificates/{id})",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/certificates/1", "host": ["{{baseUrl}}"], "path": ["api", "certificates", "1"] },
            "description": "Returns full certificate details. Replace 1 with the actual certificate id."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);"] } }
          ]
        },
        {
          "name": "Download Certificate PEM (GET /api/certificates/{id}/pem)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/certificates/1/pem", "host": ["{{baseUrl}}"], "path": ["api", "certificates", "1", "pem"] },
            "description": "Downloads the certificate in PEM format."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('PEM format', () => pm.response.text().includes('-----BEGIN CERTIFICATE-----'));"] } }
          ]
        },
        {
          "name": "Download Private Key PEM (GET /api/certificates/{id}/key)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/certificates/1/key", "host": ["{{baseUrl}}"], "path": ["api", "certificates", "1", "key"] },
            "description": "Downloads the private key in PEM format. Only the certificate owner can download the key (403 otherwise). 400 if key is on PKCS#11 device."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 or 403/400', () => [200,400,403].includes(pm.response.code));"] } }
          ]
        },
        {
          "name": "Revoke Certificate (POST /api/certificates/{id}/revoke)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/certificates/1/revoke", "host": ["{{baseUrl}}"], "path": ["api", "certificates", "1", "revoke"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"KEY_COMPROMISE\"\n}" },
            "description": "ADMIN only. Revokes a certificate. Reason must be one of: UNSPECIFIED, KEY_COMPROMISE, CA_COMPROMISE, AFFILIATION_CHANGED, SUPERSEDED, CESSATION_OF_OPERATION, CERTIFICATE_HOLD, REMOVE_FROM_CRL, PRIVILEGE_WITHDRAWN, AA_COMPROMISE."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('revoked', () => pm.response.json().data.status === 'REVOKED');"] } }
          ]
        },
        {
          "name": "Suspend Certificate (POST /api/certificates/{id}/suspend)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/certificates/1/suspend", "host": ["{{baseUrl}}"], "path": ["api", "certificates", "1", "suspend"] },
            "description": "ADMIN only. Suspends an issued certificate."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);"] } }
          ]
        },
        {
          "name": "Resume Certificate (POST /api/certificates/{id}/resume)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/certificates/1/resume", "host": ["{{baseUrl}}"], "path": ["api", "certificates", "1", "resume"] },
            "description": "ADMIN only. Resumes a suspended certificate."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);"] } }
          ]
        }
      ]
    },
    {
      "name": "CRL",
      "description": "Generate, download (DER/PEM), and view CRL history.",
      "item": [
        {
          "name": "Generate CRL (POST /api/crl/{caId}/generate)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/crl/1/generate", "host": ["{{baseUrl}}"], "path": ["api", "crl", "1", "generate"] },
            "description": "ADMIN only. Generates a new CRL for the given CA. The previous CRL is marked superseded."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('CRL generated', () => pm.response.json().success);"] } }
          ]
        },
        {
          "name": "Download CRL DER (GET /api/crl/{caId})",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/crl/1", "host": ["{{baseUrl}}"], "path": ["api", "crl", "1"] },
            "description": "Public (no auth required). Downloads the current CRL in DER binary format. Content-Type: application/pkix-crl."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('binary', () => pm.response.headers.get('content-type').includes('pkix-crl'));"] } }
          ]
        },
        {
          "name": "Download CRL PEM (GET /api/crl/{caId}/pem)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/crl/1/pem", "host": ["{{baseUrl}}"], "path": ["api", "crl", "1", "pem"] },
            "description": "Public (no auth required). Downloads the current CRL in PEM text format."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('PEM format', () => pm.response.text().includes('-----BEGIN X509 CRL-----'));"] } }
          ]
        },
        {
          "name": "CRL History (GET /api/crl/{caId}/history)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/crl/1/history", "host": ["{{baseUrl}}"], "path": ["api", "crl", "1", "history"] },
            "description": "Returns the list of all CRLs ever generated for this CA, most recent first."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('is array', () => Array.isArray(pm.response.json()));"] } }
          ]
        }
      ]
    },
    {
      "name": "OCSP",
      "description": "RFC 6960 OCSP responder endpoints (binary POST, status queries).",
      "item": [
        {
          "name": "OCSP Status Check by Serial (GET /api/ocsp/status/{serialHex})",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/ocsp/status/0102030405060708", "host": ["{{baseUrl}}"], "path": ["api", "ocsp", "status", "0102030405060708"] },
            "description": "Returns human-readable OCSP status (ISSUED / REVOKED / UNKNOWN) for a certificate serial."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('has status', () => pm.response.json().data.status);"] } }
          ]
        },
        {
          "name": "OCSP Status Check (GET /api/ocsp/status?serial=)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/ocsp/status?serial=0102030405060708",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ocsp", "status"],
              "query": [{ "key": "serial", "value": "0102030405060708", "description": "Hex serial number (no 0x prefix)" }]
            },
            "description": "Alternative query-param form of the status check."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);"] } }
          ]
        },
        {
          "name": "OCSP Binary Responder (POST /api/ocsp)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/ocsp", "host": ["{{baseUrl}}"], "path": ["api", "ocsp"] },
            "header": [
              { "key": "Content-Type", "value": "application/ocsp-request" }
            ],
            "body": {
              "mode": "binary",
              "binary": ""
            },
            "description": "Public (no auth required). Posts a DER-encoded OCSP request. Returns a DER-encoded OCSP response. Use an OCSP tool or the test in this collection to build the request."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('OCSP response', () => pm.response.headers.get('content-type').includes('ocsp-response'));"] } }
          ]
        }
      ]
    },
    {
      "name": "Certificate Profiles",
      "description": "Manage reusable certificate profiles and discover built-in profile types.",
      "item": [
        {
          "name": "List Profile Types (GET /api/profiles/types)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/profiles/types", "host": ["{{baseUrl}}"], "path": ["api", "profiles", "types"] },
            "description": "Returns the built-in profile types (CODE_SIGNING, EMAIL, etc.) with their default parameters."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('is array', () => Array.isArray(pm.response.json()));"] } }
          ]
        },
        {
          "name": "List Profiles (GET /api/profiles)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/profiles", "host": ["{{baseUrl}}"], "path": ["api", "profiles"] },
            "description": "Any authenticated user can list certificate profiles."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);", "pm.test('is array', () => Array.isArray(pm.response.json()));"] } }
          ]
        },
        {
          "name": "Get Profile by ID (GET /api/profiles/{id})",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/profiles/1", "host": ["{{baseUrl}}"], "path": ["api", "profiles", "1"] },
            "description": "Returns a single profile by id."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);"] } }
          ]
        },
        {
          "name": "Create Profile (POST /api/profiles)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/profiles", "host": ["{{baseUrl}}"], "path": ["api", "profiles"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TLS Server\",\n  \"description\": \"TLS server certificate\",\n  \"keyAlgorithm\": \"RSA\",\n  \"keySize\": 2048,\n  \"validityDays\": 365,\n  \"caProfile\": false,\n  \"keyUsage\": [\"digitalSignature\", \"keyEncipherment\"],\n  \"extendedKeyUsage\": [\"serverAuth\"]\n}"
            },
            "description": "ADMIN only. Creates a new certificate profile."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.code === 200);"] } }
          ]
        },
        {
          "name": "Update Profile (PUT /api/profiles/{id})",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/api/profiles/11", "host": ["{{baseUrl}}"], "path": ["api", "profiles", "11"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TLS Server (updated)\",\n  \"description\": \"TLS server certificate - updated\"\n}"
            },
            "description": "ADMIN only. Updates an existing profile. Adjust the profile id in the path."
